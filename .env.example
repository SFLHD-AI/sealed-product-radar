# Copy to .env (gitignored). Never commit the real key.
# Values below are the confirmed defaults (2026-10-21).
TPX_API_KEY=tp_live_xxxxxxxxxxxxxxxxxxxxxxxx
# TPX_GRAPHQL_URL=https://platform-api.tradepost.co/graphql

# sealed_wax | sealed_tcg | both
VERTICAL=both
# manual | csv | scrape | api
#   scrape: logs in with DEALERNET_USERNAME / DEALERNET_PASSWORD and reads product pages (read-only)
#   api:    uses DEALERNET_API_KEY once Dealernet issues one
DEALERNET_ACCESS=manual
# DEALERNET_USERNAME=
# DEALERNET_PASSWORD=
# DEALERNET_API_KEY=
# DEALERNET_API_URL=https://www.dealernetx.com/api
# basic | vendor  (listed-price trades 0%; name-your-price / counter 3%)
DEALERNET_PLAN=vendor

# Shipping assumptions, USD per physical move of one unit
SHIPPING_BOX_USD=15
SHIPPING_CASE_USD=45
HANDLING_USD=0

# Target margin on capital deployed (0.08 = 8%)
TARGET_MARGIN=0.08

# Risk flags
STALE_DAYS=7
THIN_BOOK_UNITS=3

# Optional: pin TPX asset type IDs once discovered (edge doctor prints them)
# TPX_ASSET_TYPE_SEALED_WAX=
# TPX_ASSET_TYPE_SEALED_TCG=

# TCGplayer reference price (sealed TCG). Public/private API keys from your TCGplayer
# developer account; leave blank to hide the "vs TCGplayer mkt" numbers.
# TCGPLAYER_PUBLIC_KEY=
# TCGPLAYER_PRIVATE_KEY=
